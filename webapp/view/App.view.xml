<mvc:View
  controllerName="performance.review.controller.App"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:tnt="sap.tnt"
>
  <tnt:ToolPage id="toolPage">
    <tnt:header>
      <tnt:ToolHeader>
        <Title text="{i18n>appTitle}" level="H1" />
      </tnt:ToolHeader>
    </tnt:header>
    <tnt:mainContents>
      <Page id="shellBody" showHeader="false">
        <IconTabBar
          id="subjectTabBar"
          select=".onSubjectSelect"
          selectedKey="{appView>/subjectId}"
          items="{subjects>/}"
        >
          <items>
            <IconTabFilter key="{subjects>id}" text="{subjects>title}" />
          </items>
        </IconTabBar>
        <VBox class="sapUiResponsiveMargin">
          <Panel class="sapUiResponsiveMargin" width="auto">
            <HBox justifyContent="SpaceBetween" alignItems="Center">
              <VBox>
                <Breadcrumbs
                  id="breadcrumbs"
                  currentLocationText="{appView>/title}"
                  links="{path: 'appView>/crumbs', templateShareable: false}"
                  class="sapUiTinyMarginBottom"
                >
                  <links>
                    <Link text="{appView>text}" press=".onCrumbPress" />
                  </links>
                </Breadcrumbs>
                <Title id="pageTitle" text="{appView>/title}" level="H2" wrapping="true" />
              </VBox>
              <ObjectStatus
                text="{appView>/position}"
                state="Information"
                inverted="true"
                visible="{= !!${appView>/position} }"
                class="sapUiSmallMarginBegin prPosition"
              />
            </HBox>
          </Panel>
        </VBox>
        <VBox id="appContent" />
        <FlexBox
          justifyContent="Center"
          class="sapUiResponsiveMargin sapUiLargeMarginTop sapUiLargeMarginBottom"
        >
          <Text text="{i18n>footerText}" class="sapUiContentPadding" />
        </FlexBox>
      </Page>
    </tnt:mainContents>
  </tnt:ToolPage>
</mvc:View>
