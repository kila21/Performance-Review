<mvc:View
  controllerName="performance.review.controller.Questions"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
>
  <VBox class="prPage">
    <MessageStrip
      text="{i18n>topicContentMissing}"
      type="Warning"
      showIcon="true"
      class="prCard"
      visible="{= !${topic>/questions}.length }"
    />
    <Panel
      headerText="{i18n>questionsListTitle}"
      class="prCard"
      width="auto"
      visible="{= !!${topic>/questions}.length }"
    >
      <List items="{path: 'topic>/questions', templateShareable: false}" mode="None" showSeparators="Inner">
        <items>
          <CustomListItem type="Active" press=".onQuestionPress">
            <HBox alignItems="Center" justifyContent="SpaceBetween" class="prQuestionRow">
              <HBox alignItems="Center" class="prQuestionTitle">
                <core:Icon src="sap-icon://question-mark" class="sapUiSmallMarginEnd" />
                <Text text="{topic>title}" />
              </HBox>
              <HBox alignItems="Center" class="prNoShrink">
              <ObjectStatus
                text="{parts: [{path: 'topic>level'}, {path: 'i18n>levelElementary'}, {path: 'i18n>levelBasic'}], formatter: '.formatter.levelText'}"
                state="{path: 'topic>level', formatter: '.formatter.levelState'}"
                inverted="true"
                visible="{= !!${topic>level} }"
                class="sapUiSmallMarginBegin"
              />
              <ObjectStatus
                text="{i18n>assignmentLabel}"
                icon="sap-icon://edit"
                state="Information"
                inverted="true"
                visible="{= !!${topic>assignment} }"
                class="sapUiSmallMarginBegin"
              />
              </HBox>
            </HBox>
          </CustomListItem>
        </items>
      </List>
    </Panel>

    <Panel
      headerText="{i18n>resourcesTitle}"
      class="prCard"
      width="auto"
      visible="{= ${topicMeta>/resources}.length > 0 }"
    >
      <VBox class="sapUiSmallMargin" items="{path: 'topicMeta>/resources', templateShareable: false}">
        <Link text="{topicMeta>title}" href="{topicMeta>url}" target="_blank" class="sapUiTinyMarginBottom" />
      </VBox>
    </Panel>
  </VBox>
</mvc:View>
