<mvc:View
  controllerName="performance.review.controller.QuestionDetail"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:codeeditor="sap.ui.codeeditor"
>
  <!-- The question itself is the page title in the shell header; Previous / Next live in the shell footer. -->
  <VBox id="detailContent" class="prPage">
    <HBox visible="{= !!${topic>level} || !!${topic>pending} }" class="prCard">
      <ObjectStatus
        text="{parts: [{path: 'topic>level'}, {path: 'i18n>levelElementary'}, {path: 'i18n>levelBasic'}, {path: 'i18n>levelAdvanced'}], formatter: '.formatter.levelText'}"
        state="{path: 'topic>level', formatter: '.formatter.levelState'}"
        inverted="true"
        visible="{= !!${topic>level} }"
        class="sapUiSmallMarginEnd"
      />
      <ObjectStatus
        text="{i18n>pendingLabel}"
        icon="sap-icon://pending"
        state="None"
        inverted="true"
        visible="{= !!${topic>pending} }"
      />
    </HBox>

    <!-- Placeholder question: no verified public source yet, so only the internal resources are shown. -->
    <VBox visible="{= !!${topic>pending} }">
      <MessageStrip text="{i18n>pendingMessage}" type="Information" showIcon="true" class="prCard" />
      <Panel
        headerText="{i18n>questionResourcesLabel}"
        class="prCard"
        width="auto"
        visible="{= !!${topic>resources} &amp;&amp; ${topic>resources}.length > 0 }"
      >
        <VBox class="sapUiSmallMargin" items="{path: 'topic>resources', templateShareable: false}">
          <Link text="{topic>title}" href="{topic>url}" target="_blank" class="sapUiTinyMarginBottom" />
        </VBox>
      </Panel>
    </VBox>

    <!-- Self-test mode: the answer stays hidden until the user asks for it. -->
    <Panel
      class="prCard"
      width="auto"
      visible="{= !${topic>pending} &amp;&amp; ${appView>/selfTest} &amp;&amp; !${ui>/answerVisible} }"
    >
      <VBox alignItems="Center" class="sapUiSmallMarginTopBottom">
        <Text text="{i18n>selfTestHint}" textAlign="Center" class="sapUiSmallMarginBottom" />
        <Button
          text="{i18n>showAnswer}"
          icon="sap-icon://show"
          type="Emphasized"
          press=".onToggleAnswer"
        />
      </VBox>
    </Panel>

    <VBox visible="{= !${topic>pending} &amp;&amp; (!${appView>/selfTest} || ${ui>/answerVisible}) }">
      <Panel headerText="{i18n>descriptionLabel}" class="prCard" width="auto">
        <FormattedText htmlText="{path: 'topic>description', formatter: '.formatter.proseHtml'}" class="prProse" />
      </Panel>

      <Panel headerText="{i18n>keyPointsLabel}" class="prCard" width="auto">
        <List items="{path: 'topic>keyPoints', templateShareable: false}" mode="None" showSeparators="None">
          <items>
            <CustomListItem class="prKeyPoint">
              <HBox alignItems="Start">
                <core:Icon src="sap-icon://accept" class="prKeyPointIcon" />
                <FormattedText htmlText="{path: 'topic>', formatter: '.formatter.inlineTextHtml'}" class="prProse" />
              </HBox>
            </CustomListItem>
          </items>
        </List>
      </Panel>

      <Panel
        headerText="{i18n>examplesLabel}"
        class="prCard"
        width="auto"
        visible="{= !!${topic>examples} &amp;&amp; ${topic>examples}.length > 0 }"
      >
        <VBox items="{path: 'topic>examples', templateShareable: false}">
          <VBox class="prExample">
            <FormattedText
              htmlText="{path: 'topic>title', formatter: '.formatter.inlineTextHtml'}"
              class="prExampleTitle sapUiSmallMarginBottom"
            />
            <codeeditor:CodeEditor
              value="{topic>code}"
              type="{topic>language}"
              editable="false"
              height="{path: 'topic>code', formatter: '.formatter.codeEditorHeight'}"
            />
          </VBox>
        </VBox>
      </Panel>

      <!-- Side-by-side comparison of how the topic works in OData V2 and V4 (only on questions that have one). -->
      <Panel
        headerText="{i18n>versionDiffLabel}"
        class="prCard"
        width="auto"
        visible="{= !!${topic>versionDiff} &amp;&amp; ${topic>versionDiff}.length > 0 }"
      >
        <Table items="{path: 'topic>versionDiff', templateShareable: false}" fixedLayout="false">
          <columns>
            <Column width="12rem">
              <Text text="{i18n>versionDiffAspect}" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true">
              <Text text="{i18n>versionDiffV2}" />
            </Column>
            <Column minScreenWidth="Tablet" demandPopin="true">
              <Text text="{i18n>versionDiffV4}" />
            </Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{topic>aspect}" wrapping="true" />
                <Text text="{topic>v2}" wrapping="true" />
                <Text text="{topic>v4}" wrapping="true" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </Panel>

      <!-- The official pages the answer was written from. -->
      <Panel
        headerText="{i18n>sourcesLabel}"
        class="prCard"
        width="auto"
        visible="{= !!${topic>sources} &amp;&amp; ${topic>sources}.length > 0 }"
      >
        <VBox class="sapUiSmallMargin" items="{path: 'topic>sources', templateShareable: false}">
          <Link text="{topic>title}" href="{topic>url}" target="_blank" wrapping="true" class="sapUiTinyMarginBottom" />
        </VBox>
      </Panel>

      <FlexBox
        justifyContent="Center"
        visible="{appView>/selfTest}"
        class="prCard"
      >
        <Button
          text="{i18n>hideAnswer}"
          icon="sap-icon://hide"
          type="Transparent"
          press=".onToggleAnswer"
        />
      </FlexBox>
    </VBox>

    <Panel
      headerText="{i18n>assignmentLabel}"
      class="prCard"
      width="auto"
      visible="{= ${topic>assignment} !== null }"
    >
      <VBox>
        <FormattedText
          htmlText="{path: 'topic>assignment/task', formatter: '.formatter.inlineTextHtml'}"
          class="prProse sapUiSmallMarginBottom"
        />
        <codeeditor:CodeEditor
          value="{topic>assignment/starterCode}"
          type="javascript"
          editable="false"
          height="{path: 'topic>assignment/starterCode', formatter: '.formatter.codeEditorHeight'}"
          class="sapUiSmallMarginBottom"
        />
        <Button
          text="{= ${ui>/solutionVisible} ? ${i18n>hideSolution} : ${i18n>showSolution} }"
          press=".onToggleSolution"
          class="sapUiSmallMarginBottom"
        />
        <codeeditor:CodeEditor
          visible="{ui>/solutionVisible}"
          value="{topic>assignment/solution}"
          type="javascript"
          editable="false"
          height="{path: 'topic>assignment/solution', formatter: '.formatter.codeEditorHeight'}"
        />
      </VBox>
    </Panel>
  </VBox>
</mvc:View>
