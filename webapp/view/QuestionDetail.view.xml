<mvc:View
  controllerName="performance.review.controller.QuestionDetail"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:codeeditor="sap.ui.codeeditor"
>
  <!-- The question itself is the page title in the shell header; Previous / Next live in the shell footer. -->
  <VBox id="detailContent" class="prPage">
    <HBox visible="{= !!${topic>level} }" class="prCard">
      <ObjectStatus
        text="{parts: [{path: 'topic>level'}, {path: 'i18n>levelElementary'}, {path: 'i18n>levelBasic'}], formatter: '.formatter.levelText'}"
        state="{path: 'topic>level', formatter: '.formatter.levelState'}"
        inverted="true"
      />
    </HBox>
    <!-- Self-test mode: the answer stays hidden until the user asks for it. -->
    <Panel
      class="prCard"
      width="auto"
      visible="{= ${appView>/selfTest} &amp;&amp; !${ui>/answerVisible} }"
    >
      <VBox alignItems="Center" class="sapUiSmallMarginTopBottom">
        <Text text="{i18n>selfTestHint}" textAlign="Center" class="sapUiSmallMarginBottom" />
        <Button
          text="{i18n>showAnswer}"
          icon="sap-icon://show"
          type="Emphasized"
          press=".onToggleAnswer"
        />
      </VBox>
    </Panel>

    <VBox visible="{= !${appView>/selfTest} || ${ui>/answerVisible} }">
      <Panel headerText="{i18n>descriptionLabel}" class="prCard" width="auto">
        <FormattedText htmlText="{path: 'topic>description', formatter: '.formatter.proseHtml'}" class="prProse" />
      </Panel>

      <Panel headerText="{i18n>keyPointsLabel}" class="prCard" width="auto">
        <List items="{path: 'topic>keyPoints', templateShareable: false}" mode="None" showSeparators="None">
          <items>
            <CustomListItem class="prKeyPoint">
              <HBox alignItems="Start">
                <core:Icon src="sap-icon://accept" class="prKeyPointIcon" />
                <FormattedText htmlText="{path: 'topic>', formatter: '.formatter.inlineTextHtml'}" class="prProse" />
              </HBox>
            </CustomListItem>
          </items>
        </List>
      </Panel>

      <Panel headerText="{i18n>examplesLabel}" class="prCard" width="auto">
        <VBox items="{path: 'topic>examples', templateShareable: false}">
          <VBox class="prExample">
            <FormattedText
              htmlText="{path: 'topic>title', formatter: '.formatter.inlineTextHtml'}"
              class="prExampleTitle sapUiSmallMarginBottom"
            />
            <codeeditor:CodeEditor
              value="{topic>code}"
              type="{topic>language}"
              editable="false"
              height="{path: 'topic>code', formatter: '.formatter.codeEditorHeight'}"
            />
          </VBox>
        </VBox>
      </Panel>

      <FlexBox
        justifyContent="Center"
        visible="{appView>/selfTest}"
        class="prCard"
      >
        <Button
          text="{i18n>hideAnswer}"
          icon="sap-icon://hide"
          type="Transparent"
          press=".onToggleAnswer"
        />
      </FlexBox>
    </VBox>

    <Panel
      headerText="{i18n>assignmentLabel}"
      class="prCard"
      width="auto"
      visible="{= ${topic>assignment} !== null }"
    >
      <VBox>
        <FormattedText
          htmlText="{path: 'topic>assignment/task', formatter: '.formatter.inlineTextHtml'}"
          class="prProse sapUiSmallMarginBottom"
        />
        <codeeditor:CodeEditor
          value="{topic>assignment/starterCode}"
          type="javascript"
          editable="false"
          height="{path: 'topic>assignment/starterCode', formatter: '.formatter.codeEditorHeight'}"
          class="sapUiSmallMarginBottom"
        />
        <Button
          text="{= ${ui>/solutionVisible} ? ${i18n>hideSolution} : ${i18n>showSolution} }"
          press=".onToggleSolution"
          class="sapUiSmallMarginBottom"
        />
        <codeeditor:CodeEditor
          visible="{ui>/solutionVisible}"
          value="{topic>assignment/solution}"
          type="javascript"
          editable="false"
          height="{path: 'topic>assignment/solution', formatter: '.formatter.codeEditorHeight'}"
        />
      </VBox>
    </Panel>
  </VBox>
</mvc:View>
