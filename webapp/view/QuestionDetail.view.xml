<mvc:View
  controllerName="performance.review.controller.QuestionDetail"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:codeeditor="sap.ui.codeeditor"
>
  <VBox class="sapUiResponsiveMargin">
    <Bar class="sapUiResponsiveMargin prNavBar">
      <contentLeft>
        <Button
          text="{i18n>previous}"
          icon="sap-icon://navigation-left-arrow"
          type="Transparent"
          enabled="{nav>/hasPrevious}"
          press=".onPrevious"
        />
      </contentLeft>
      <contentRight>
        <Button
          text="{i18n>next}"
          icon="sap-icon://navigation-right-arrow"
          iconFirst="false"
          type="Transparent"
          enabled="{nav>/hasNext}"
          press=".onNext"
        />
      </contentRight>
    </Bar>

    <Panel id="questionPanel" headerText="{i18n>questionLabel}" class="sapUiResponsiveMargin" width="auto">
      <Title text="{topic>title}" level="H2" />
    </Panel>

    <Panel headerText="{i18n>descriptionLabel}" class="sapUiResponsiveMargin" width="auto">
      <FormattedText htmlText="{path: 'topic>description', formatter: '.formatter.proseHtml'}" class="prProse" />
    </Panel>

    <Panel headerText="{i18n>keyPointsLabel}" class="sapUiResponsiveMargin" width="auto">
      <List items="{path: 'topic>keyPoints', templateShareable: false}" mode="None" showSeparators="None">
        <items>
          <CustomListItem class="prKeyPoint">
            <HBox alignItems="Start">
              <core:Icon src="sap-icon://accept" class="prKeyPointIcon" />
              <FormattedText htmlText="{path: 'topic>', formatter: '.formatter.inlineTextHtml'}" class="prProse" />
            </HBox>
          </CustomListItem>
        </items>
      </List>
    </Panel>

    <Panel headerText="{i18n>examplesLabel}" class="sapUiResponsiveMargin" width="auto">
      <VBox items="{path: 'topic>examples', templateShareable: false}">
        <VBox class="prExample">
          <FormattedText
            htmlText="{path: 'topic>title', formatter: '.formatter.inlineTextHtml'}"
            class="prExampleTitle sapUiSmallMarginBottom"
          />
          <codeeditor:CodeEditor
            value="{topic>code}"
            type="{topic>language}"
            editable="false"
            height="{path: 'topic>code', formatter: '.formatter.codeEditorHeight'}"
          />
        </VBox>
      </VBox>
    </Panel>

    <Panel
      headerText="{i18n>assignmentLabel}"
      class="sapUiResponsiveMargin"
      width="auto"
      visible="{= ${topic>assignment} !== null }"
    >
      <VBox>
        <FormattedText
          htmlText="{path: 'topic>assignment/task', formatter: '.formatter.inlineTextHtml'}"
          class="prProse sapUiSmallMarginBottom"
        />
        <codeeditor:CodeEditor
          value="{topic>assignment/starterCode}"
          type="javascript"
          editable="false"
          height="{path: 'topic>assignment/starterCode', formatter: '.formatter.codeEditorHeight'}"
          class="sapUiSmallMarginBottom"
        />
        <Button
          text="{= ${ui>/solutionVisible} ? ${i18n>hideSolution} : ${i18n>showSolution} }"
          press=".onToggleSolution"
          class="sapUiSmallMarginBottom"
        />
        <codeeditor:CodeEditor
          visible="{ui>/solutionVisible}"
          value="{topic>assignment/solution}"
          type="javascript"
          editable="false"
          height="{path: 'topic>assignment/solution', formatter: '.formatter.codeEditorHeight'}"
        />
      </VBox>
    </Panel>

    <Bar class="sapUiResponsiveMargin prNavBar">
      <contentLeft>
        <Button
          text="{i18n>previous}"
          icon="sap-icon://navigation-left-arrow"
          type="Transparent"
          enabled="{nav>/hasPrevious}"
          press=".onPrevious"
        />
      </contentLeft>
      <contentRight>
        <Button
          text="{i18n>next}"
          icon="sap-icon://navigation-right-arrow"
          iconFirst="false"
          type="Transparent"
          enabled="{nav>/hasNext}"
          press=".onNext"
        />
      </contentRight>
    </Bar>
  </VBox>
</mvc:View>
