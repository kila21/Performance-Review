{
  "_version": "1.68.0",
  "sap.app": {
    "id": "performance.review",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [""],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}"
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "performance.review.view.App",
      "type": "XML",
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.154.0",
      "libs": {
        "sap.m": {
          "lazy": false
        },
        "sap.ui.core": {
          "lazy": false
        },
        "sap.ui.codeeditor": {
          "lazy": false
        },
        "sap.tnt": {
          "lazy": false
        }
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "performance.review.i18n.i18n"
        }
      }
    },
    "routing": {
      "config": {
        "viewType": "XML",
        "viewPath": "performance.review.view",
        "controlId": "appContent",
        "controlAggregation": "items",
        "clearControlAggregation": true,
        "async": true,
        "bypassed": {
          "target": "notFound"
        }
      },
      "routes": [
        {
          "name": "root",
          "pattern": ""
        },
        {
          "name": "subject",
          "pattern": "{subjectId}",
          "target": "topics"
        },
        {
          "name": "topic",
          "pattern": "{subjectId}/{topicId}",
          "target": "questions"
        },
        {
          "name": "question",
          "pattern": "{subjectId}/{topicId}/{questionId}",
          "target": "questionDetail"
        }
      ],
      "targets": {
        "topics": {
          "viewName": "Topics"
        },
        "questions": {
          "viewName": "Questions"
        },
        "questionDetail": {
          "viewName": "QuestionDetail"
        },
        "notFound": {
          "viewName": "NotFound"
        }
      }
    },
    "resources": {
      "css": []
    }
  }
}
